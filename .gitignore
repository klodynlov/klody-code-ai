# Environnement
.env
.env.local
.env.production
.env.staging

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.Python
env/
venv/
.venv/

# Tests
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Logs (garder le dossier). L'état persistant — sessions, long_term.json,
# semantic_memory.db, user_profile.json — vit désormais hors du repo, dans
# MEMORY_DIR (~/.klody/data par défaut) : git ne le voit plus, rien à ignorer ici.
logs/*.log
logs/distill_book_last_invalid.json
logs/distill/
!logs/.gitkeep

# macOS
.DS_Store
.AppleDouble

# IDE
.vscode/
.idea/
*.swp
.aider*

# Claude Code
.claude/

# Aperçu local
_preview/
preview/

# Artefacts générés téléchargeables (Excel, etc.)
_downloads/

# Images uploadées par le front (vision B-lite)
_uploads/

# Bench results (locaux, gros JSON)
bench/results/*.json
bench/results/*.md
!bench/results/.gitkeep
# EXCEPTION : la baseline est versionnée. Le gate de non-régression du nightly
# la lit depuis un checkout frais — ignorée, elle n'existait jamais côté CI, donc
# le gate tombait toujours dans sa branche « pas de baseline → on accepte » et ne
# pouvait structurellement pas échouer. La promouvoir : `python -m bench.run
# --promote-baseline` (ou copier un run existant sur bench/results/baseline.json).
!bench/results/baseline.json
# EXCEPTION : les runs de RÉFÉRENCE, gardés parce qu'ils établissent un fait qu'on
# citera plus tard (stabilité, comparaison de modèles, effet d'un correctif). Un run
# ordinaire reste local — sinon le dépôt collecterait un JSON par exécution.
# Convention : préfixer `reference_` pour verser une mesure au dépôt.
!bench/results/reference_*.json
# Les mesures ne sont pas toutes des runs de bench : certaines sont des relevés
# rédigés (appels d'outils instance par instance, balayages de latence). La
# convention disait « préfixer reference_ », mais la dé-ignore ne couvrait que
# .json — un reference_*.md était donc silencieusement ignoré par `git add`, et
# reference_2026-07-30_appels_outils_jumeaux.md n'est dans le dépôt que parce
# qu'il a été forcé. La convention vaut pour les deux formats.
!bench/results/reference_*.md

# Mémoire agent
memory/

# Klody cache (conventions, erreurs récurrentes — Roadmap v2 #8)
.klody/

# PID files de l'orchestrateur d'inférence locale (start-local-ai.sh)
.run/
graphify-out/

# artefacts runtime (régénérables)
.env.bak*
data/
skills/*.json
# EXCEPTION : les digests de distillation. La règle ci-dessus les a emportés le
# 2026-07-03 (2518676) sous le motif « régénérables via l'export distill » — le
# motif est faux. Un digest est une synthèse LLM non déterministe de livres de
# Library Brain : le relancer produit un AUTRE texte, et les 3 runs de
# `auto_distill.py` (state/assistant.db, table distill_runs) comme les ~44
# `/distill` manuels ne sont pas rejouables à l'identique. Ce sont les seuls
# artefacts durables de la boucle : un `git clean -xdf` les détruisait sans trace.
# Même convention que bench/results/reference_* : le préfixe promeut au dépôt.
# Les 4 premiers (digest_design_d_api_rest, _mastering_claude_ai,
# _prompt_engineering, _threejs_3d) étaient déjà versionnés avant la règle — la
# preuve que le versionnement était l'intention d'origine.
!skills/digest_*.json
# ...SAUF ces deux-là. Contenu vérifié sans donnée personnelle (droit du travail
# français générique, aucun nom, aucun employeur), mais ce dépôt est PUBLIC et sur
# ces sujets la simple présence du fichier est un signal. Décision utilisateur du
# 2026-09-22 : ils restent LOCAUX. Une règle plutôt qu'un simple `git rm --cached`,
# pour qu'un `git add` de masse ne puisse pas les réintroduire par accident.
# ⚠️ Conséquence : pas de copie git pour ces deux fichiers, et ils n'ont pas de
# jumeau dans ~/Documents/Livres/.brain_distilled/ (digests `/distill` écrits
# directement ici). Leur seul filet est Time Machine.
skills/digest_conflits_toxiques_diffamation.json
skills/digest_procedure_disciplinaire_harceleme.json

# … sauf les skills LibraryBrain, qui sont des livrables versionnés et non
# des artefacts runtime : produits par scripts/import-librarybrain-methods.py
# et chargés par l'agent au démarrage.
!skills/librarybrain_*.json
