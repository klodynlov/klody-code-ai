<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Runtime renforcé : sans ce droit, macOS refuse les Apple Events (envoi par
       Messages.app) émis au nom de l'app, sans même afficher la demande. -->
  <key>com.apple.security.automation.apple-events</key><true/>
  <!-- Runtime renforcé : sans ce droit, EventKit (agenda ET app Rappels) est
       refusé sans demande — même famille que le droit apple-events. -->
  <key>com.apple.security.personal-information.calendars</key><true/>
</dict>
</plist>
