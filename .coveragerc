[run]
branch = True
source = agent,tools,api
omit =
    */__pycache__/*
    */tests/*
    */.venv/*
    */lora/*
    */bench/*
    */imports/*
    # api/server.py est désormais DANS le scope : le chemin WS chat est couvert
    # par tests/integration/test_websocket_chat.py (faux client OpenAI streaming
    # branché à _build_streaming_orchestrator) en plus des routes REST.

[report]
# Gate à 80% (relevée depuis 75% le 2026-07-29). Le seuil de 75 datait de la
# réintégration d'api/server.py au scope, quand le total mesuré était ~75.5% ; la
# couverture avait depuis grimpé à 80.4% sans que le garde-fou suive.
#
# ⚠️ MARGE ÉTROITE — ASSUMÉE. Mesure CI du 2026-07-29 : 80.44% (8291 stmts, 1471
# manquants, Python 3.11). Il reste donc ~36 statements de jeu avant échec : une
# seule fonction non testée d'une trentaine de lignes fait rougir la CI. C'est
# l'effet recherché — le code non couvert doit coûter quelque chose — mais cela
# veut dire qu'ajouter du code sans test devient bloquant, pas seulement
# déconseillé.
#
# En cas d'échec : couvrir le code ajouté (voie normale) plutôt que rabaisser le
# seuil. Les modules structurellement peu testables (agent/semantic_memory.py à
# 28%, tools/audio.py à 25%, tools/embeddings.py à 18% — tous dépendants de
# services externes) sont les premiers candidats si on veut regagner de la marge.
fail_under = 80
precision = 1
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    \.\.\.

[html]
directory = htmlcov

[xml]
output = coverage.xml
