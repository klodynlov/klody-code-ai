[run]
branch = True
source = agent,tools,api
omit =
    */__pycache__/*
    */tests/*
    */.venv/*
    */lora/*
    */bench/*
    */imports/*
    # api/server.py est désormais DANS le scope : le chemin WS chat est couvert
    # par tests/integration/test_websocket_chat.py (faux client OpenAI streaming
    # branché à _build_streaming_orchestrator) en plus des routes REST.

[report]
# Gate à 75% : seuil posé après réintégration d'api/server.py au scope (chemin WS
# chat couvert par test_websocket_chat.py), quand le total mesuré était ~75.5%.
# Mesure du 2026-07-29 : 80.55% (8291 stmts, 1463 manquants). La marge s'est
# creusée d'elle-même — on garde la gate à 75 pour ne pas transformer chaque
# ajout de code non couvert en échec de CI, mais l'écart se surveille.
fail_under = 75
precision = 1
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    \.\.\.

[html]
directory = htmlcov

[xml]
output = coverage.xml
