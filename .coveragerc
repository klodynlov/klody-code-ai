[run]
branch = True
source = agent,tools,api
omit =
    */__pycache__/*
    */tests/*
    */.venv/*
    */lora/*
    */bench/*
    */imports/*
    # api/server.py est désormais DANS le scope : le chemin WS chat est couvert
    # par tests/integration/test_websocket_chat.py (faux client OpenAI streaming
    # branché à _build_streaming_orchestrator) en plus des routes REST.

[report]
# Gate à 80% (relevée depuis 75% le 2026-07-29). Le seuil de 75 datait de la
# réintégration d'api/server.py au scope, quand le total mesuré était ~75.5% ; la
# couverture avait depuis grimpé à 80.4% sans que le garde-fou suive.
#
# Marge au 2026-07-29 : 82.1% mesuré (8291 stmts, 1329 manquants), soit ~175
# statements de jeu. Elle était de ~36 juste après le relèvement du seuil ;
# couvrir agent/semantic_memory.py (28% → 98%) l'a quintuplée.
#
# En cas d'échec : couvrir le code ajouté (voie normale) plutôt que rabaisser le
# seuil. Restent peu couverts, et pour la même raison — une dépendance externe
# absente en CI : tools/audio.py (25%) et tools/embeddings.py (18%). La recette
# qui a marché pour semantic_memory est dans tests/fake_klody_memory.py : un
# double du paquet manquant injecté dans sys.modules, avec le vrai SQLite
# derrière, de sorte que c'est bien le code du dépôt qui est jugé.
fail_under = 80
precision = 1
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    \.\.\.

[html]
directory = htmlcov

[xml]
output = coverage.xml
