[run]
branch = True
source = agent,tools,api
omit =
    */__pycache__/*
    */tests/*
    */.venv/*
    */lora/*
    */bench/*
    */imports/*
    # api/server.py est désormais DANS le scope : le chemin WS chat est couvert
    # par tests/integration/test_websocket_chat.py (faux client OpenAI streaming
    # branché à _build_streaming_orchestrator) en plus des routes REST.

[report]
# Gate à 80% (relevée depuis 75% le 2026-07-29). Le seuil de 75 datait de la
# réintégration d'api/server.py au scope, quand le total mesuré était ~75.5% ; la
# couverture avait depuis grimpé à 80.4% sans que le garde-fou suive.
#
# Marge au 2026-07-29 : 84.3% mesuré (8291 stmts, 1142 manquants), soit ~357
# statements de jeu. Elle était de ~36 juste après le relèvement du seuil ; les
# trois modules que la CI ne pouvait pas exercer l'ont rendue confortable —
# semantic_memory (28→98%), embeddings (18→100%), audio (25→96%).
#
# Tous les trois étaient bas pour la MÊME raison, et aucune n'était « code
# structurellement peu testable » : une dépendance absente en CI (klody_memory,
# librosa/soundfile) faisait sortir le module sur sa dégradation douce avant
# d'exécuter quoi que ce soit. La recette est dans tests/fake_klody_memory.py et
# tests/fake_audio_libs.py — doubler UNIQUEMENT le paquet manquant, en gardant
# réels SQLite, numpy et les fichiers, pour que ce soit bien le code du dépôt qui
# soit jugé. Elle a d'ailleurs déterré un fade_out cassé depuis toujours.
#
# En cas d'échec : couvrir le code ajouté plutôt que rabaisser le seuil.
fail_under = 80
precision = 1
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    \.\.\.

[html]
directory = htmlcov

[xml]
output = coverage.xml
