<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.klody.veille-qwen</string>

    <!-- Veille sur la publication des poids Qwen3.8 (annoncés le 2026-08-03,
         absents de l'org Qwen/ au 2026-08-07). Notifie quand un dépôt Qwen3.8
         apparaît chez Qwen, mlx-community ou unsloth ET que son config.json
         confirme qu'il contient bien des poids. Détail dans le script. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/klodynlov/Projets/klody-code-ai/scripts/veille_qwen.py</string>
    </array>

    <!-- 86400 s = 24 h. `est_periodique()` de scripts/install-launchagents.sh
         ne reconnaissait que StartInterval ; il accepte aussi un calendrier
         depuis le 2026-09-27 (com.klody.bench-dispatch).
         ⚠️ Jamais deux tirets d'affilée dans un commentaire XML : launchd et
         plutil le tolèrent, un analyseur strict (plistlib) refuse le fichier.
         Ce commentaire-ci citait l'option check de l'installeur avec ses
         tirets, et rendait le plist illisible à tout test qui le parse. -->
    <key>StartInterval</key>
    <integer>86400</integer>

    <!-- Tire au chargement : sans ça, installer l'agent ne prouve rien avant
         24 h, et une veille qu'on n'a pas vue tourner est une veille supposée. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/klodynlov/Library/Logs/klody-veille-qwen.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/klodynlov/Library/Logs/klody-veille-qwen.log</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
